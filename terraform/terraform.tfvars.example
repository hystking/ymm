# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.
project_name        = "ymm-music-player"   # must be a globally-unique S3 bucket name
aws_region          = "ap-northeast-1"
basic_auth_user     = "admin"
basic_auth_password = "change-me-please"   # better: export TF_VAR_basic_auth_password=...
basic_auth_realm    = "ymm music player"
price_class         = "PriceClass_200"
